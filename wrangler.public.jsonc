{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pets-model",
  "main": "./cloudflare/worker.mjs",
  "compatibility_date": "2026-05-22",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "DAILY_MODEL_LIMIT": "100"
  },
  "ratelimits": [
    { "name": "CHAT_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 6, "period": 60 } }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "MODEL_BUDGET", "class_name": "ModelBudget" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ModelBudget"] }
  ]
}
